# RoadVis Trainer settings. Copy to .env and edit. Never commit .env.

# Admin token for /api/v1/admin/* and the Colab notebook. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ROADVIS_ADMIN_TOKEN=change-me

# Public URL prefix behind the reverse proxy (https://trafficcounter.uz/roadvis → /roadvis). Alias: ROOT_PATH.
ROADVIS_ROOT_PATH=/roadvis

# Where SQLite, incoming files, the dataset and the models live (Docker: /data).
# ROADVIS_DATA_DIR=/data

# Ingest limits (contract defaults).
# ROADVIS_MAX_IMAGE_BYTES=2097152
# ROADVIS_DAILY_LIMIT=600

# Worker: teacher model and CPU budget. yolo11x.pt (~110 MB) is downloaded on first use.
ROADVIS_TEACHER_MODEL=yolo11x.pt
ROADVIS_TEACHER_IMGSZ=1280
ROADVIS_WORKER_THREADS=2
# ROADVIS_WORKER_BATCH=4
# ROADVIS_WORKER_POLL_SECONDS=15

# Dataset.
# ROADVIS_TEST_FREEZE_AT=300
# ROADVIS_DATASET_CAP=50000

# Quality gate and publishing.
# ROADVIS_EVAL_IMGSZ=960
# ROADVIS_BASELINE_MODEL=yolo11s.pt
# ROADVIS_GATE_MIN_TEST_IMAGES=100
# ROADVIS_KEEP_VERSIONS=3
# ROADVIS_MAX_CANDIDATE_BYTES=629145600

# Expose /docs (OpenAPI UI). Off in production.
# ROADVIS_ENABLE_DOCS=0
