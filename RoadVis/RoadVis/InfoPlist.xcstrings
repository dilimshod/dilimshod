    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to recognize vehicles, traffic lights and pedestrians on the road."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера нужна для распознавания транспортных средств, светофоров и пешеходов на дороге."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera yo‘ldagi transport vositalari, svetoforlar va piyodalarni aniqlash uchun kerak."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During navigation your location is also used in the background so that guidance keeps working."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время навигации геопозиция используется и в фоне, чтобы подсказки продолжали работать."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigatsiya vaqtida geolokatsiya fonda ham ishlatiladi, shunda ko‘rsatmalar ishlashda davom etadi."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used for driving speed, navigation, lane data and speed limits."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геопозиция нужна для скорости движения, навигации, данных о полосах и ограничениях скорости."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geolokatsiya harakat tezligi, navigatsiya, bo‘laklar va tezlik cheklovlari haqidagi ma’lumotlar uchun kerak."
          }
        }
      }
    }
  },
  "version" : "1.0"
